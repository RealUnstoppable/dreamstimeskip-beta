rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Access Control
    // ===============================================================
    //
    // Collection: users/{userId}
    //   - User profile document containing identity (username, email, phone, photoURL), display preferences (theme, accentColor),
    //     security settings (twoFactorEnabled, twoFactorMethod), and social/gaming profiles (minecraft, discord, etc.).
    //   - Access control:
    //       * read: Authenticated owner (request.auth.uid == userId) or admin (isAdmin()).
    //       * create: Authenticated owner (request.auth.uid == userId) ensuring unprivileged defaults
    //                 (isAdmin == false, isBanned == false, membershipLevel == 'free', and no protected keys:
    //                 'plan', 'subscription', 'loyaltyPoints', 'pointsBalance') or admin (isAdmin()).
    //       * update: Authenticated owner (request.auth.uid == userId) preserving protected fields
    //                 (!affectedKeys().hasAny(['isAdmin', 'isBanned', 'membershipLevel', 'plan', 'subscription', 'loyaltyPoints', 'pointsBalance']))
    //                 or admin (isAdmin()).
    //       * delete: Admin only (isAdmin()).
    //
    // Subcollection: users/{userId}/consents/{consentId}
    //   - Immutable consent ledger records tracking privacy choices & policy acceptance
    //   - Direct client SDK access: Locked down (writes disabled; reads admin-only)
    //
    // Collection: sessions/{sessionId}
    //   - First-party telemetry session records
    //   - Direct client SDK access: Locked down (writes disabled; reads admin-only)
    //
    // Subcollection: sessions/{sessionId}/eventBatches/{batchId}
    //   - Telemetry batched event logs
    //   - Direct client SDK access: Locked down (writes disabled; reads admin-only)
    //
    // Preserved Application Collections:
    //   - /dts_waitlist, /minecraft_links, /carts, /wishlists, /loyalty_transactions,
    //     /orders, /support_tickets, /blog_comments, /reviews, /products, /product_stats,
    //     /product_questions, /product_reviews, /bookings, /inquiries, /faqs,
    //     /feature_requests, /newsletterSubscribers, /reward_transactions,
    //     /notifications, /artist_tracks, /promo_codes
    // ===============================================================

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('isAdmin', false) == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }

    // ===============================================================
    // User Profiles & Preferences Collection
    // Allows users to manage their own profile and display preferences (theme, accentColor, socials).
    // Privileged fields (isAdmin, isBanned, membershipLevel, plan, subscription, loyaltyPoints, pointsBalance)
    // are strictly locked against unauthorized client-side creation or modification.
    // ===============================================================

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && (
        (request.auth.uid == userId
         && request.resource.data.get('isAdmin', false) == false
         && request.resource.data.get('isBanned', false) == false
         && request.resource.data.get('membershipLevel', 'free') == 'free'
         && !request.resource.data.keys().hasAny(['plan', 'subscription', 'loyaltyPoints', 'pointsBalance']))
        || isAdmin()
      );
      allow update: if request.auth != null && (
        (request.auth.uid == userId
         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isBanned', 'membershipLevel', 'plan', 'subscription', 'loyaltyPoints', 'pointsBalance']))
        || isAdmin()
      );
      allow delete: if isAdmin();

      // Nested consents subcollection: Immutable consent ledger records
      // All writes occur exclusively via the trusted backend. Client SDK reads are restricted to admin only.
      match /consents/{consentId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;

      match /eventBatches/{batchId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Dreams TimeSkip waitlist collection (/dts_waitlist/{entryId})
    match /dts_waitlist/{entryId} {
      allow get: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.minecraftUsername is string
                    && request.resource.data.minecraftUsername.size() > 0;
      allow update: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Minecraft username claim/link collection (/minecraft_links/{usernameKey})
    match /minecraft_links/{usernameKey} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid 
                    && request.resource.data.minecraftUsername is string 
                    && request.resource.data.minecraftUsername.size() > 0;
      allow update: if request.auth != null 
                    && (resource.data.uid == request.auth.uid || isAdmin()) 
                    && (request.resource.data.uid == resource.data.uid || isAdmin());
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Carts collection: Users can only read/write their own cart
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Wishlists collection: Users can only read/write their own wishlist
    match /wishlists/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || resource.data.isPublic == true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders collection: Users can read their own orders and create new ones
    // Loyalty transactions
    match /loyalty_transactions/{transactionId} {
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      allow list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      allow list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      // Depending on checkout implementation, orders are created by user or backend.
      // Assuming frontend creation for now based on 'userId' equality:
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Support tickets collection
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Blog Comments Collection
    match /blog_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reviews collection: Anyone can read, but only authenticated users can create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin())
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Products collection: Any site or shopper can view products; direct client writes restricted to admin
    match /products/{productId} {
      allow read: if true; // Any site or shopper can view products
      allow write: if isAdmin(); // Direct client writes restricted; Cloud Functions bypass rules
    }

    // Product stats collection: Anyone can read, only backend can write
    match /product_stats/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Product Q&A Collection
    match /product_questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());

      match /answers/{answerId} {
        allow read: if true;
        allow create: if isAdmin() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() && request.resource.data.userId == request.auth.uid;
      }
    }

    // Product reviews collection
    match /product_reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      // Users can only create their own reviews, rating must be 1-5
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userEmail == request.auth.token.email
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      // Users can update or delete their own reviews
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.userEmail == resource.data.userEmail
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Autolux Collections
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Feature requests collection
    match /feature_requests/{requestId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Upvotes subcollection
      match /upvotes/{userId} {
        allow read: if true;
      }
    }

    match /newsletterSubscribers/{email} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /newsletter_subscribers/{email} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Reward Transactions collection
    match /reward_transactions/{transactionId} {
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      allow list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    // Artist Tracks Collection
    match /artist_tracks/{trackId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.artistId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.artistId == request.auth.uid || isAdmin());
    }

    // Promo codes collection: Anyone can read, only admin can write
    match /promo_codes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
