# ========================================================
# Medixly & Stripe Production Environment Configuration
# ========================================================

# Stripe Secret API Key (Live or Test mode: sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_mock

# Stripe Webhook Signing Secret (from Stripe Dashboard -> Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_test_mock

# Medixly Promotion Campaign Launch Date (UTC ISO 8601 string)
# Promotion starts at $1.00 and increases by $1.00 every midnight UTC.
MEDIXLY_PROMO_START_DATE=2026-10-28T00:00:00Z

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=dts-hub-website
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@dts-hub-website.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Port for local server (optional)
PORT=3000
